generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Supabase: DATABASE_URL lewat pooler (port 6543), DIRECT_URL koneksi langsung untuk migrasi.
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String            @id @default(cuid())
  email               String            @unique
  passwordHash        String
  name                String
  initials            String
  roleLabel           String            @default("Pelajar")
  cefrLevel           String            @default("B1")
  cefrProgressLabel   String            @default("A2+ menuju B1")
  cefrProgressPct     Int               @default(70)
  goals               String[]          @default(["kerja", "harian"])
  dailyTargetMinutes  Int               @default(15)
  clarityAvg          Int               @default(0)
  streakFreezes       Int               @default(2)
  correctionPref      String            @default("giliran")
  saveAudioOptIn      Boolean           @default(false)
  onboardingCompleted Boolean           @default(false)
  micChecked          Boolean           @default(false)
  activeScenarioSlug  String            @default("memesan-di-kafe")
  // Liga mingguan: ikut atas pilihan sendiri, hanya nama panggilan yang tampil.
  leagueOptIn         Boolean           @default(false)
  leagueNickname      String?
  consentDate         DateTime          @default(now())
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  sessions            SpeakingSession[]
  speechAttempts      SpeechAttempt[]
  chapterProgress     ChapterProgress[]
  mistakes            MistakeItem[]
}

model PhonemeGuide {
  id                    String @id @default(cuid())
  phoneme               String @unique
  errorPattern          String
  title                 String
  description           String
  articulationStepsJson String
  minimalPairsJson      String
}

model DrillSentence {
  id                   String @id @default(cuid())
  goalTag              String @default("harian")
  cefrLevel            String @default("B1")
  category             String
  focusPhonemes        String
  text                 String
  ipa                  String
  translation          String
  orderIndex           Int
  targetMarksJson      String
  sampleScoresJson     String
  coachWord            String
  coachIpa             String
  coachNote            String
  coachStepsJson       String
  phonemeBreakdownJson String
  minimalPairsJson     String
}

model Scenario {
  id                String         @id @default(cuid())
  slug              String         @unique
  goalTag           String         @default("harian")
  title             String
  category          String
  cefrLevel         String
  characterName     String
  characterRole     String
  characterTrait    String
  description       String
  missionsJson      String
  usefulPhrasesJson String
  nodes             ScenarioNode[]
}

model ScenarioNode {
  id                   String   @id @default(cuid())
  scenarioId           String
  scenario             Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  stepIndex            Int
  speaker              String
  speakerLine          String
  translation          String
  hintsJson            String
  targetMission        Int
  sampleCorrectionJson String?
}

model SpeakingSession {
  id                 String      @id @default(cuid())
  userId             String
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode               String
  scenarioTitle      String?
  durationSec        Int
  clarityScore       Int
  pronunciationScore Int
  fluencyScore       Int
  grammarScore       Int
  vocabularyScore    Int
  wpm                Int         @default(0)
  // Menit bicara dari lama rekaman; sumber target harian, streak, grafik, dan liga.
  spokenMinutes      Int         @default(0)
  // Bab yang dikerjakan di sesi ini (drill:<tujuan>:<level> atau roleplay:<slug>), bila ada.
  chapterKey         String?
  confidenceRating   Int?
  startedAt          DateTime    @default(now())
  endedAt            DateTime    @default(now())
  utterances         Utterance[]

  @@index([userId, startedAt])
}

model Utterance {
  id            String          @id @default(cuid())
  sessionId     String
  session       SpeakingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  referenceText String
  transcript    String
  betterVersion String?
  status        String
  note          String?
  clarityScore  Int
  audioUrl      String?
  phonemeScores PhonemeScore[]
}

model PhonemeScore {
  id           String    @id @default(cuid())
  utteranceId  String
  utterance    Utterance @relation(fields: [utteranceId], references: [id], onDelete: Cascade)
  word         String
  phoneme      String
  score        Int
  errorPattern String?
}

model MistakeItem {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  word            String
  ipa             String
  phoneme         String
  errorPattern    String
  heardAs         String
  sourceMode      String
  occurrenceCount Int      @default(1)
  status          String   @default("work")
  scheduleLabel   String   @default("hari ini")
  nextReviewAt    DateTime @default(now())
  // Tahap pengulangan berjarak: 0 = baru salah (ulang hari ini), 1..4 = jarak 1, 3, 7, 14 hari.
  reviewStage     Int      @default(0)
  lastPracticedAt DateTime?
  masteredAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, word])
}



// Satu rekaman yang dinilai server. Hanya durasi dan waktu: audio dan transkrip tidak disimpan.
// Sumber menit bicara (target harian, streak, liga) dan kuota pengenal suara.
model SpeechAttempt {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  audioSec  Float
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Cache audio contoh TTS agar teks yang sama tidak dibuat ulang (berlaku lintas instance serverless).
model TtsCache {
  key       String   @id
  audio     Bytes
  createdAt DateTime @default(now())
}

// Bab yang sudah diselesaikan pengguna. Bab berikutnya di jalur yang sama terbuka setelah ini ada.
model ChapterProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapterKey  String
  bestClarity Int      @default(0)
  completedAt DateTime @default(now())

  @@unique([userId, chapterKey])
}
