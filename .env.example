# Salin ke .env.local lalu isi nilainya. Jangan pernah commit .env atau .env.local.
# Next.js membaca .env lalu .env.local (.env.local menang). Prisma CLI hanya membaca .env,
# sedangkan script db:seed / db:reset / db:setup membaca keduanya.

# Laragon PostgreSQL
DATABASE_URL="postgresql://postgres@127.0.0.1:5432/ucapin?schema=public"

# Kunci penanda tangan cookie sesi, minimal 32 karakter acak.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Akun testing lokal (dipakai seed dan pintasan 1-klik di /masuk).
# Pintasan hanya aktif jika ENABLE_TEST_ACCOUNTS="true" dan bukan mode production.
ENABLE_TEST_ACCOUNTS="true"
TEST_ACCOUNT_NEW_EMAIL=""
TEST_ACCOUNT_ACTIVE_EMAIL=""
TEST_ACCOUNT_PASSWORD=""

# ElevenLabs: pengenal suara (Scribe) untuk menilai ucapan dan suara contoh (TTS).
# Kunci butuh izin speech_to_text dan text_to_speech. Tanpa kunci, perekaman tidak bisa dinilai.
ELEVENLABS_API_KEY=""
# Opsional: ganti suara contoh (default: suara bawaan ElevenLabs beraksen Amerika).
ELEVENLABS_VOICE_ID=""

# Azure AI Speech (cadangan untuk penilaian per fonem; belum dipakai)
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION="southeastasia"
